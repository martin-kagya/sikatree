# Copy to .env.local and fill in. Never commit .env.local.

# Postgres. Locally: createdb sikatree_dev. In production use the Supabase
# pooler connection string (Project settings > Database > Connection string).
DATABASE_URL=postgres://localhost:5432/sikatree_dev

# Password for /admin. Generate one: openssl rand -base64 24
ADMIN_PASSWORD=

# WhatsApp number the "Confirm on WhatsApp" button opens (digits only, with
# country code, e.g. 233241234567). Leave blank to hide the button.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# How long a waitlist handle reservation is held, in days.
RESERVATION_DAYS=30

# Optional: Cloudflare Turnstile secret for stronger bot protection.
TURNSTILE_SECRET_KEY=
