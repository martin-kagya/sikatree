# Copy to .env.local and fill in. Never commit .env.local.

# Postgres. Locally: createdb sikatree_dev.
# Production uses the Supabase pooler (Project settings > Database > Connection
# string > Session pooler). The direct db.<ref>.supabase.co host is IPv6 only.
DATABASE_URL=postgres://localhost:5432/sikatree_dev

# Supabase pooler TLS presents a self-signed chain, so the app encrypts without
# verifying the chain. Set to true only if the provider serves a trusted cert.
DATABASE_SSL_STRICT=false

# Password for /admin. Generate one: openssl rand -base64 24

# WhatsApp number the "Confirm on WhatsApp" button opens (digits only, with
# country code, e.g. 233241234567). Leave blank to hide the button.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# How long a waitlist handle reservation is held, in days.
RESERVATION_DAYS=30

# Founding vendor offer (LP-16). Read at build time.
FOUNDING_VENDORS_ENABLED=true
FOUNDING_VENDORS_CAPACITY=100
FOUNDING_FEE_FREE_MONTHS=3
FOUNDING_BADGE_NAME=Founding Vendor

# WhatsApp Cloud API. Leave the provider as console locally: the bot then
# prints replies to the server log and needs no Meta account.
WHATSAPP_PROVIDER=console
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Base URL used in magic links and Paystack callbacks. Leave blank for the
# canonical https://sikatree.africa; set http://localhost:3001 for local tests or a
# tunnel URL for webhook testing.
APP_URL=

# Vendor dashboard sessions (magic links) and the job worker.
AUTH_SECRET=
CRON_SECRET=

# Email. Without RESEND_API_KEY the app prints sign-in links to the server log
# outside production; in production email sign-in stays off until a key is set.
# EMAIL_FROM must be a verified sender in Resend.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM="sikatree <hello@sikatree.africa>"

# Paystack. Setting the secret key turns on "Pay now" at checkout. Use the test
# key (sk_test_...) until the business compliance review is complete. The test
# and live keys behave the same; the webhook URL is
# https://<domain>/api/payments/paystack and is signed with this secret.
PAYSTACK_SECRET_KEY=
# How long a pending online payment holds its order before the job runner
# cancels it and restores stock. Default 30.
PAYMENT_HOLD_MINUTES=30

# Optional: Cloudflare Turnstile secret for stronger bot protection.
TURNSTILE_SECRET_KEY=

# Supabase project values. The waitlist talks to Postgres directly through
# DATABASE_URL, so these are reserved for Storage, Auth and Edge Functions.
# Only NEXT_PUBLIC_* values may reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Public bucket for item photos. The app uploads with the secret key.
SUPABASE_STORAGE_BUCKET=items
