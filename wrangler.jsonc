{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sikatree",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    // Required for Next.js + pg on Workers.
    "nodejs_compat",
    // Allow the global fetch() to reach Supabase Storage and the WhatsApp API.
    "global_fetch_strictly_public"
  ],
  // Lift the per-request CPU ceiling (10ms free / 30ms paid default) so DB-heavy
  // routes — the analytics ingest, the 5,000-row CSV export, the WhatsApp bot —
  // don't trip "exceededCpu". Billed only for CPU actually used, not the cap.
  "limits": {
    "cpu_ms": 3000
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Supabase Postgres through Cloudflare Hyperdrive. lib/db.ts reads
  // env.HYPERDRIVE.connectionString, so the binding name must be exactly
  // HYPERDRIVE.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a56e4608851d4b47ae6edc7ded341660",
      // Used only when running `wrangler dev` / the local platform proxy; the
      // real connection string is supplied by Hyperdrive at runtime. This local
      // value just needs to be a syntactically valid Postgres URL.
      "localConnectionString": "postgres://localhost:5432/sikatree_dev"
    }
  ],
  // OpenNext self-reference, required for server actions and routing.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sikatree"
    }
  ]
}
