{
  // Version-controlled Cloudflare Worker configuration.
  // The deployment target is Cloudflare Workers (sikatree.zqt.workers.dev), not Vercel.
  //
  // If the Worker is deployed from the Cloudflare dashboard (Workers Builds Git
  // integration), the Worker name and build command live there; this file carries
  // the bindings and runtime flags so they survive redeploys and Worker recreates.
  // For a wrangler CLI deploy, `wrangler deploy` reads this file directly.

  "name": "sikatree",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Supabase Postgres through Cloudflare Hyperdrive. The code reads
  // env.HYPERDRIVE.connectionString, so the binding name must be exactly
  // HYPERDRIVE. Replace the id with your Hyperdrive configuration's id
  // (Workers & Pages → Hyperdrive → your config).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "<YOUR_HYPERDRIVE_CONFIG_ID>"
    }
  ]
}
